# ==============================================================================
# So-What Agent: 환경변수 템플릿 (.env.example)
# 복사하여 .env 파일로 생성한 후 유효한 API 키를 입력하세요.
# ==============================================================================

# 1. OpenAI API (필수: 파싱, 목차 설계, SCQA 최종 보고서 작성)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Tavily Search API (필수: 외부 비즈니스 팩트 고속 검색)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Notion REST API (선택: 1-Click 전략 DB 내보내기)
# NOTION_TOKEN 또는 NOTION_API_KEY
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. Hugging Face (선택: Zero-Shot 모델 로컬 자동 다운로드 시 비워둠)
# HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
